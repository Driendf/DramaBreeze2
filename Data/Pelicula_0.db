[{"title":"Roofman: Un buen ladrón","img":"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEgfhYCgsJiGn10A70jHF8-wF6VNNti3cKNlvfY-Ecs19sOfHbYHP8WteaEh4Q6iMjcjqStsB1MdDRgy4writzmbDYEjgtSZbx8QuMIKKmkGZOf5INnpDDYc9vpzrz-0_0eD_oqYh0rFsFXfTs5l1GB817yYEXIi4_lIO7UExJjsqx87ZD-lm1x8q-1CX0Mb/s320/000.jpg","link":"https://peli3221.blogspot.com/2026/10/p00005-1.html","sinopsis":"La historia del ladrón de tejados, Jeffrey Manchester, y su tiempo como fugitivo eludiendo la captura.","category":"pelicula","franchiseId":"P00005","franchiseOrder":1,"tags":["crimen","drama","historia","latino","romance"]},{"title":"Zapatero a tus zapatos","img":"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEharf4n2O2B7u7MbSk_y6Ft4UOZBAl7e_aIpwbrLSZZps4u2KseI4Zcuus5I6uICqLHI8LIl0GAhTfz2gSN8Tdtmc2y8D84s_aAeJBGy0iyu8_5RXadBzZLzhF8cIl3bGkHvBoK34wyfuGaF7qv717rYIW9PaAkrF1dQj0NDdEkcvobo2x9ZsANCXkeSyI/s320/01.jpg","link":"https://peli3221.blogspot.com/2026/10/p00004-1.html","sinopsis":"Max Simkin repara zapatos en la misma tienda neoyorquina que ha pertenecido a su familia durante generaciones. Desencantado con su rutina diaria, Max tropieza con una reliquia familiar que le permite ser testigo de la vida de sus clientes y ver el mundo de una forma totalmente nueva. A veces, caminar con los zapatos de otra persona es la única manera de descubrir quién eres realmente.","category":"pelicula","franchiseId":"P00004","franchiseOrder":1,"tags":["comedia","latino"]},{"title":"Adorable criatura","img":"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEiQiqps5Ys9duyKFhwFMIwe61_Nf-TOiJ7Ujuis8_lRJce51_f1t3Ekkn8WxHNukb-wzc7BhkVlEc0lxqlk9yl2G6Y6LlUbqfpzg9SUhKm9KsbtCQzCT0024TI-5fhlFCkU4o4TyanWNVB9ISFM5ySbHaMCNLQxX2xibOOEJoLCBFC8fI6WDzOyeP68iaw/s763/000.png","link":"https://peli3221.blogspot.com/2026/10/p00003-1.html","sinopsis":"Un niño es un monstruito. Lo adoptan un hombre cariñoso y su excéntrica esposa. El chico lleva su paciencia al límite, y las risas están aseguradas.","category":"pelicula","franchiseId":"P00003","franchiseOrder":1,"tags":["comedia","latino"]},{"title":"El sacramento","img":"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEhA2Yg3fKjqaiA8TdG37oyexyJOarjIfcB_gB5C73enPokY-FUN5qch3rD1OTqakcAvbdJsa_zuUiNASQOYcaf3yja9f8_YM0RA1p_6fehQh4eFflSuqdYm1NXw57rEPoEficWj2awcv6l8IMNYCfPPalxabzPQLzRB7Y9sXvm9AxSYdcvLSJxAXCVr1S0/s444/SS.jpg","link":"https://peli3221.blogspot.com/2026/10/p00002-1.html","sinopsis":"Unos cineastas se verán atrapados en una ceremonia de una secta que planea realizar un inesperado y sorprendente acto.","category":"pelicula","franchiseId":"P00002","franchiseOrder":1,"tags":["suspenso","horror","latino"]},{"title":"Malditas","img":"https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEhsCYiBH5hNc9dyzRiAGhI0a7LsHDRplK_Ti32JSrpwuIQgyD6UvXA5Pv4ncYokk02tbO4XM-dLbZqm_oXCRaQGsimz-HMEr_IXhWLRb-JZEO3BkgnHiiB3ZYFvGI7pGWexTHtslazSxDzC9aTf5JfipEDThUP3WgjnDkkrG4jtTIhrmyPYz73b74pZk5w/s320/SSS.jpg","link":"https://peli3221.blogspot.com/2026/10/p00001-1.html","sinopsis":"Las vidas de seis niñas pertenecen a mundos diferentes aunque conectados entre sí por una muñeca cuya existencia se remonta a 1976, cuando apareció entre los escombros del gran incendio del orfanato de San Carlos, al norte de España.","category":"pelicula","franchiseId":"P00001","franchiseOrder":1,"tags":["horror","accion","latino"]}]
